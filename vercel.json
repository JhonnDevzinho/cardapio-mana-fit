{
  "redirects": [
    { "source": "/", "destination": "/cliente/", "permanent": false },
    { "source": "/cliente", "destination": "/cliente/", "permanent": true },
    { "source": "/lojista", "destination": "/lojista/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/lojista/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
