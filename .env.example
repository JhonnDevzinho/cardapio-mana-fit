# Variáveis de ambiente do servidor de pagamentos (cadastre na Vercel: Settings > Environment Variables).
# NÃO coloque valores reais neste arquivo nem no GitHub.
MP_ACCESS_TOKEN=APP_USR-... (Access Token do Mercado Pago)
# Troque para true somente depois de configurar o Access Token de produção na Vercel.
MP_LIVE_MODE=false
# Segredo de assinatura configurado no webhook do Mercado Pago.
MP_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ... (conteúdo INTEIRO do JSON da conta de serviço, em uma linha)}
FIREBASE_DATABASE_URL=https://SEU-PROJETO-default-rtdb.firebaseio.com
SITE_URL=https://seu-site.vercel.app   (opcional)
DELIVERY_FEE=6                         (opcional)
